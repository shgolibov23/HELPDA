# Bu faylni .env nomi bilan nusxalang:  cp .env.example .env
# So'ng qiymatlarni o'zingizniki bilan almashtiring. .env faylini hech kimga yubormang!

# PostgreSQL manzili. Parolsiz lokal baza uchun:
DATABASE_URL=postgresql+psycopg://localhost/helpda_db
# Parol bilan:  postgresql+psycopg://FOYDALANUVCHI:PAROL@localhost:5432/helpda_db

# JWT imzosi uchun uzun tasodifiy qator. Yaratish:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=BU_YERGA_O'ZINGIZNING_UZUN_TASODIFIY_QATORINGIZNI_YOZING

ACCESS_TOKEN_EXPIRE_HOURS=24

# Faqat dasturlashda true qiling (GET /db-test ni yoqadi)
ENABLE_DB_TEST=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ---- Telegram bot (ixtiyoriy) ----
# @BotFather orqali bot yarating. Tokenni HECH KIMGA yubormang.
# TELEGRAM_BOT_TOKEN=
# Botning username'i (@ belgisisiz):
# TELEGRAM_BOT_USERNAME=
# Arizani ko'rib tasdiqlaydigan adminlarning Telegram ID'lari (vergul bilan). Botga /id yozib bilib oling.
# TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_POLLING=true

# Ixtiyoriy. Biznes arizasi tavsiya tahlili uchun OpenAI API kaliti.
# Kalit mijozlarga yuborilmaydi va faqat serverda ishlatiladi.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
